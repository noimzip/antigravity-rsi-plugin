{
  "rsi-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/guard_harness.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "rsi-telemetry": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/trace_collector.py --event post_tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/inner_gate.py",
        "timeout": 15
      }
    ]
  }
}
